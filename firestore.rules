rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).coupleId == coupleId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || (
          resource.data.coupleId is string
          && isCoupleMember(resource.data.coupleId)
        )
      );
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.coupleId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn()
        && isCoupleMember(resource.data.coupleId);
    }

    match /couples/{coupleId} {
      allow read: if isCoupleMember(coupleId);
      allow create: if signedIn()
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isCoupleMember(coupleId);
      allow delete: if isCoupleMember(coupleId);

      match /items/{itemId} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }
  }
}
